<UserControl
    x:Class="Orbit.Views.OrbitGridLayoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:converters="clr-namespace:Orbit.Converters"
    xmlns:dockablz="http://dragablz.net/winfx/xaml/dockablz"
    xmlns:dragablz="http://dragablz.net/winfx/xaml/dragablz"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Orbit"
    xmlns:models="clr-namespace:Orbit.Models"
    Foreground="{DynamicResource Orbit.Brushes.Text.Primary}"
    FontFamily="{DynamicResource Orbit.Fonts.Family}"
    FontSize="{DynamicResource Orbit.Fonts.Size.Base}"
    FontWeight="{DynamicResource Orbit.Fonts.Weight.Body}">

    <UserControl.Resources>
        <converters:OrbitViewBorderThicknessConverter x:Key="BorderThicknessConverter" />
        <converters:OrbitViewTabHeaderSizeToHeightConverter x:Key="TabHeaderSizeConverter" />
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
        <Style
            x:Key="SessionToolbarButtonStyle"
            BasedOn="{StaticResource Orbit.Workbench.Button}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="1">
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="8,0" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="MinWidth" Value="62" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                    <Setter Property="Height" Value="26" />
                    <Setter Property="Padding" Value="6,0" />
                    <Setter Property="Margin" Value="2,0" />
                    <Setter Property="MinWidth" Value="58" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SessionToolbarNumericStyle" TargetType="{x:Type Controls:NumericUpDown}">
            <Setter Property="Height" Value="32" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="1">
                    <Setter Property="Height" Value="28" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                    <Setter Property="Height" Value="26" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrbitRootGridStyle" TargetType="Grid" BasedOn="{StaticResource Orbit.Workbench.PageRoot}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                    <Setter Property="Margin" Value="6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrbitToolbarRowStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="1">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrbitToolbarGroupStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{DynamicResource Orbit.Brushes.Surface.Subtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Orbit.Brushes.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="1">
                    <Setter Property="Padding" Value="4,3" />
                    <Setter Property="Margin" Value="0,0,6,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                    <Setter Property="Padding" Value="3,2" />
                    <Setter Property="Margin" Value="0,0,4,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OrbitToolbarDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource Orbit.Brushes.Border.Subtle}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="1">
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Margin" Value="6,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                    <Setter Property="Height" Value="20" />
                    <Setter Property="Margin" Value="4,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <!--  Keyboard shortcuts for quick grid layout creation  -->
        <KeyBinding
            Key="D2"
            Command="{Binding CreateGrid2x2Command}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="D3"
            Command="{Binding CreateGrid3x3Command}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="R"
            Command="{Binding ResetLayoutCommand}"
            Modifiers="Ctrl+Shift" />
    </UserControl.InputBindings>

    <Grid Style="{StaticResource OrbitRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header with controls  -->
        <Border Grid.Row="0" HorizontalAlignment="Stretch">
            <Border.Style>
                <Style BasedOn="{StaticResource Orbit.ToolHeader}" TargetType="Border">
                    <Setter Property="Margin" Value="0,0,0,10" />
                    <Setter Property="Padding" Value="12" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="1">
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Padding" Value="8,6,8,6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                            <Setter Property="Margin" Value="0,0,0,3" />
                            <Setter Property="Padding" Value="4,2,4,2" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Header summary (full density only)  -->
                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="1"
                    Grid.Column="0"
                    Margin="0,0,16,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Orbit.ToolHeaderIcon}">
                        <iconPacks:PackIconMaterial Kind="ViewGrid" Style="{StaticResource Orbit.ToolHeaderIconGlyph}" />
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            Style="{StaticResource Orbit.ToolHeaderTitle}"
                            Text="Orbit View" />
                        <TextBlock
                            Style="{StaticResource Orbit.ToolHeaderSubtitle}"
                            Text="Live session grid - Drag to edges to split" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource Orbit.Workbench.MetaText}"
                            Text="{Binding SuggestedGridLabel}" />
                    </StackPanel>
                </Grid>

                <!-- Full toolbar groups wrap as the workspace narrows. -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <WrapPanel>
                        <Border Style="{StaticResource OrbitToolbarGroupStyle}" Margin="0,0,8,6">
                            <WrapPanel>
                                <Button Command="{Binding CreateGrid2x2Command}" Content="2x2" Style="{StaticResource SessionToolbarButtonStyle}" ToolTip="Create 2x2 Grid (Ctrl+Shift+2)" />
                                <Button Command="{Binding CreateGrid3x3Command}" Content="3x3" Style="{StaticResource SessionToolbarButtonStyle}" ToolTip="Create 3x3 Grid (Ctrl+Shift+3)" />
                                <Button Command="{Binding AutoFitGridCommand}" Content="Auto Fit" Style="{StaticResource SessionToolbarButtonStyle}" />
                            </WrapPanel>
                        </Border>
                        <Border Style="{StaticResource OrbitToolbarGroupStyle}" Margin="0,0,8,6">
                            <WrapPanel>
                                <TextBlock VerticalAlignment="Center" Text="Rows" Margin="0,0,6,0" />
                                <Controls:NumericUpDown Width="70" Minimum="1" Maximum="6" Value="{Binding CustomRows, Mode=TwoWay}" Style="{StaticResource SessionToolbarNumericStyle}" />
                                <TextBlock VerticalAlignment="Center" Text="Cols" Margin="8,0,6,0" />
                                <Controls:NumericUpDown Width="70" Minimum="1" Maximum="6" Value="{Binding CustomColumns, Mode=TwoWay}" Style="{StaticResource SessionToolbarNumericStyle}" />
                                <Button Command="{Binding CreateCustomGridCommand}" Content="Apply" Style="{StaticResource SessionToolbarButtonStyle}" ToolTip="Create the specified grid" />
                            </WrapPanel>
                        </Border>
                        <Border Style="{StaticResource OrbitToolbarGroupStyle}" Margin="0,0,8,6">
                            <WrapPanel>
                                <Button Command="{Binding ResetLayoutCommand}" Content="Reset" Style="{StaticResource SessionToolbarButtonStyle}" ToolTip="Reset to Single View (Ctrl+Shift+R)" />
                                <Button Command="{Binding BalanceRowsCommand}" Content="Balance Rows" Style="{StaticResource SessionToolbarButtonStyle}" />
                                <Button Command="{Binding BalanceColumnsCommand}" Content="Balance Cols" Style="{StaticResource SessionToolbarButtonStyle}" />
                            </WrapPanel>
                        </Border>
                    </WrapPanel>
                    <WrapPanel>
                        <TextBlock VerticalAlignment="Center" Text="Header:" Margin="0,0,8,0" />
                        <RadioButton Content="Full" Padding="8,2" Margin="0,0,4,0" Style="{StaticResource MahApps.Styles.ToggleButton}"
                                      IsChecked="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:SessionHeaderDensity.Full}}" />
                        <RadioButton Content="Compact" Padding="8,2" Margin="0,0,4,0" Style="{StaticResource MahApps.Styles.ToggleButton}"
                                      IsChecked="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:SessionHeaderDensity.Compact}}" />
                        <RadioButton Content="Minimal" Padding="8,2" Style="{StaticResource MahApps.Styles.ToggleButton}"
                                      IsChecked="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:SessionHeaderDensity.Minimal}}" />
                    </WrapPanel>
                </StackPanel>
                <!--  Compact/minimal toolbar (single row with dividers)  -->
                <Grid Grid.Row="0" Grid.Column="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="1">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource OrbitToolbarGroupStyle}">
                            <WrapPanel VerticalAlignment="Center">
                                <Button
                                    Command="{Binding AdoptSessionsIntoOrbitCommand}"
                                    Style="{StaticResource SessionToolbarButtonStyle}"
                                    ToolTip="Move current session tabs into the Orbit workspace">
                                    <TextBlock FontWeight="SemiBold" Text="Adopt Sessions" />
                                </Button>
                            </WrapPanel>
                        </Border>
                        <Border Style="{StaticResource OrbitToolbarDividerStyle}" />
                        <Border Style="{StaticResource OrbitToolbarGroupStyle}">
                            <WrapPanel VerticalAlignment="Center">
                                <Button
                                    Command="{Binding CreateGrid2x2Command}"
                                    Style="{StaticResource SessionToolbarButtonStyle}"
                                    ToolTip="Create 2x2 Grid (Ctrl+Shift+2)">
                                    <TextBlock FontWeight="SemiBold" Text="2x2" />
                                </Button>
                                <Button
                                    Command="{Binding CreateGrid3x3Command}"
                                    Style="{StaticResource SessionToolbarButtonStyle}"
                                    ToolTip="Create 3x3 Grid (Ctrl+Shift+3)">
                                    <TextBlock FontWeight="SemiBold" Text="3x3" />
                                </Button>
                                <Button
                                    Command="{Binding AutoFitGridCommand}"
                                    Style="{StaticResource SessionToolbarButtonStyle}"
                                    ToolTip="Auto-fit grid to current sessions">
                                    <TextBlock FontWeight="SemiBold" Text="Auto Fit" />
                                </Button>
                            </WrapPanel>
                        </Border>
                        <Border Style="{StaticResource OrbitToolbarDividerStyle}" />
                        <Border Style="{StaticResource OrbitToolbarGroupStyle}">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Orbit.Workbench.FieldLabel}"
                                    Text="R" />
                                <Controls:NumericUpDown
                                    Width="60"
                                    Maximum="6"
                                    Minimum="1"
                                    Style="{StaticResource SessionToolbarNumericStyle}"
                                    Value="{Binding CustomRows, Mode=TwoWay}" />
                                <TextBlock
                                    Margin="8,0,6,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Orbit.Workbench.FieldLabel}"
                                    Text="C" />
                                <Controls:NumericUpDown
                                    Width="60"
                                    Maximum="6"
                                    Minimum="1"
                                    Style="{StaticResource SessionToolbarNumericStyle}"
                                    Value="{Binding CustomColumns, Mode=TwoWay}" />
                                <Button
                                    Command="{Binding CreateCustomGridCommand}"
                                    Style="{StaticResource SessionToolbarButtonStyle}"
                                    ToolTip="Create a custom grid">
                                    <TextBlock FontWeight="SemiBold" Text="Apply" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style BasedOn="{StaticResource OrbitToolbarDividerStyle}" TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border>
                            <Border.Style>
                                <Style BasedOn="{StaticResource OrbitToolbarGroupStyle}" TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                                            <Setter Property="Padding" Value="2,1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <WrapPanel VerticalAlignment="Center">
                                <Button
                                    Command="{Binding ResetLayoutCommand}"
                                    Style="{StaticResource SessionToolbarButtonStyle}"
                                    ToolTip="Reset to Single View (Ctrl+Shift+R)">
                                    <TextBlock FontWeight="SemiBold" Text="Reset" />
                                </Button>
                                <Button
                                    Command="{Binding BalanceRowsCommand}"
                                    Style="{StaticResource SessionToolbarButtonStyle}"
                                    ToolTip="Evenly resize all rows">
                                    <TextBlock FontWeight="SemiBold" Text="Rows" />
                                </Button>
                                <Button
                                    Command="{Binding BalanceColumnsCommand}"
                                    Style="{StaticResource SessionToolbarButtonStyle}"
                                    ToolTip="Evenly resize all columns">
                                    <TextBlock FontWeight="SemiBold" Text="Cols" />
                                </Button>
                            </WrapPanel>
                        </Border>
                    </WrapPanel>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity}" Value="2">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource Orbit.Workbench.FieldLabel}"
                            Text="Header:" />
                        <RadioButton
                            Margin="0,0,4,0"
                            Padding="8,2"
                            Content="Full"
                            IsChecked="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:SessionHeaderDensity.Full}}"
                            Style="{StaticResource MahApps.Styles.ToggleButton}" />
                        <RadioButton
                            Margin="0,0,4,0"
                            Padding="8,2"
                            Content="Compact"
                            IsChecked="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:SessionHeaderDensity.Compact}}"
                            Style="{StaticResource MahApps.Styles.ToggleButton}" />
                        <RadioButton
                            Padding="8,2"
                            Content="Minimal"
                            IsChecked="{Binding Source={x:Static local:Settings.Default}, Path=OrbitHeaderDensity, Mode=TwoWay, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static models:SessionHeaderDensity.Minimal}}"
                            Style="{StaticResource MahApps.Styles.ToggleButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  Main Layout Area using Dragablz Layout  -->
        <Grid
            Grid.Row="1"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <!--  Dragablz Layout Control - Native branching/splitting  -->
            <dockablz:Layout x:Name="SessionLayout" Partition="OrbitMainShell">

                <!--  BranchTemplate: Defines how each branch (tab control) looks  -->
                <!--  NOTE: Do NOT bind ItemsSource here - Dragablz manages items internally when branching  -->
                <dockablz:Layout.BranchTemplate>
                    <DataTemplate>
                        <dragablz:TabablzControl
                            Margin="0"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Orbit.Brushes.Text.Primary}"
                            BorderThickness="{Binding Source={x:Static local:Settings.Default}, Path=OrbitViewBorderThickness, Converter={StaticResource BorderThicknessConverter}}"
                            ClosingItemCallback="{Binding DataContext.TabClosingHandler, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ContentTemplateSelector="{StaticResource TabContentTemplateSelector}"
                            Style="{StaticResource Orbit.TabablzControlStyle}"
                            SelectionChanged="OrbitTabControl_SelectionChanged"
                            ShowDefaultAddButton="False"
                            ShowDefaultCloseButton="True">

                            <dragablz:TabablzControl.InterTabController>
                                <dragablz:InterTabController InterTabClient="{Binding DataContext.InterTabClient, RelativeSource={RelativeSource AncestorType=UserControl}}" Partition="OrbitMainShell" />
                            </dragablz:TabablzControl.InterTabController>
                        </dragablz:TabablzControl>
                    </DataTemplate>
                </dockablz:Layout.BranchTemplate>

                <!--  Initial content: Single TabablzControl showing all sessions  -->
                <dragablz:TabablzControl
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderBrush="{DynamicResource Orbit.Brushes.Action.Primary}"
                    BorderThickness="{Binding Source={x:Static local:Settings.Default}, Path=OrbitViewBorderThickness, Converter={StaticResource BorderThicknessConverter}}"
                    ClosingItemCallback="{Binding TabClosingHandler}"
                    ContentTemplateSelector="{StaticResource TabContentTemplateSelector}"
                    Style="{StaticResource Orbit.TabablzControlStyle}"
                    SelectionChanged="OrbitTabControl_SelectionChanged"
                    ShowDefaultAddButton="False"
                    ShowDefaultCloseButton="True">

                    <dragablz:TabablzControl.InterTabController>
                        <dragablz:InterTabController InterTabClient="{Binding InterTabClient}" Partition="OrbitMainShell" />
                    </dragablz:TabablzControl.InterTabController>
                </dragablz:TabablzControl>

            </dockablz:Layout>

        </Grid>
    </Grid>
</UserControl>
